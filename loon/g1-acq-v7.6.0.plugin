#!name=G1 ACQ
#!desc=G1 ACQ v7.6.0 — Loon format

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Script]
http-response ^https:\/\/one\.google\.com\/ script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.6.0/g1-acq.js,requires-body=true,timeout=10,tag=g1-acq
http-request ^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.6.0/g1-sku-report.js,timeout=10,tag=g1-sku-report

[MitM]
hostname = one.google.com
