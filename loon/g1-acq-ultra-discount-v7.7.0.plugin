#!name=G1 ACQ Ultra 一折
#!desc=v7.7.0 一折优先入口（Loon）

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT

[Script]
http-response ^https:\/\/one\.google\.com\/ script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.7.0/g1-acq-discount.js,requires-body=true,timeout=10,tag=g1-acq
http-request ^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$ script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.7.0/g1-sku-report-discount.js,timeout=10,tag=g1-sku-report

[MitM]
hostname = one.google.com
